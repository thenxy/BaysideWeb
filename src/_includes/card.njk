<a class="card" href="{{ p.url }}" data-cat="{{ p.data.category }}" data-sub="{{ p.data.subcategory }}" data-search="{% for c in p.data.colours %}{{ c.name }} {% endfor %}">
  <div class="card__img">
    {% if p.data.image %}
      <img src="{{ p.data.image | thumb }}" alt="{{ p.data.title }}" loading="lazy">
    {% else %}
      <span class="swatch" aria-hidden="true"></span>
    {% endif %}
  </div>
  <div class="card__body">
    {% if p.data.colours.length > 1 %}<p class="card__brand">{{ p.data.colours.length }} colours</p>{% endif %}
    <h3>{{ p.data.title }}</h3>
    {% if p.data.thickness %}<p class="card__meta">{{ p.data.thickness }}</p>{% endif %}
  </div>
</a>
