<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} | {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.tagline }}">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Figtree:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="top">
    <div class="wrap top__in">
      <a class="brand" href="/" aria-label="{{ site.name }} home">
        <span class="brand__mark" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="brand__name">Bayside <em>Flooring Studio</em></span>
      </a>
      <nav class="nav" id="nav" aria-label="Main">
        <a href="/products/">Products</a>
        <div class="nav__group">
          <button class="nav__btn" type="button" aria-expanded="false" aria-controls="flooring-menu">Flooring <span class="nav__chev" aria-hidden="true"></span></button>
          <div class="nav__menu" id="flooring-menu">
            {% for c in categories %}{% if c.key != "carpet" %}<a href="/products/{{ c.key }}/">{{ c.name }}</a>{% endif %}{% endfor %}
          </div>
        </div>
        <a href="/products/carpet/">Carpet</a>
      </nav>
      <a class="btn btn--sm top__quote" href="/quote/">Free quote</a>
      <button class="burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav"><span></span><span></span><span></span></button>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="foot">
    <div class="wrap foot__grid">
      <div>
        <p class="foot__brand">{{ site.name }}</p>
        <p>{{ site.supplierNote }}</p>
      </div>
      <div>
        <p class="foot__h">Browse</p>
        <ul>{% for c in categories %}<li><a href="/products/{{ c.key }}/">{{ c.name }}</a></li>{% endfor %}</ul>
      </div>
      <div>
        <p class="foot__h">Get in touch</p>
        <ul>
          <li><a href="tel:{{ site.phoneLink }}">{{ site.phone }}</a></li>
          <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
          <li>{{ site.hours }}</li>
        </ul>
      </div>
    </div>
    <div class="wrap foot__base">
      <span>Website &copy; {{ "" | year }} {{ site.name }}. Product names and images belong to their respective owners.</span>
      <a href="/quote/">Book a free on-site quote</a>
    </div>
  </footer>

  <div class="dock" role="group" aria-label="Quick contact">
    <a href="tel:{{ site.phoneLink }}">Call</a>
    <a class="dock__main" href="/quote/">Free on-site quote</a>
  </div>
  <script src="/js/site.js" defer></script>
</body>
</html>
