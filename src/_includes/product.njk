---
layout: base.njk
---
{% set cat = categories | selectattr("key", "equalto", category) | first %}
<section class="wrap pdp">
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/products/">Products</a> / <a href="/products/{{ category }}/">{{ cat.name }}</a> / <span>{{ title }}</span>
  </nav>
  <div class="pdp__grid">
    <div class="pdp__media">
      {% if image %}<img src="{{ image }}" alt="{{ brand }} {{ title }}">{% else %}<span class="swatch swatch--lg" aria-hidden="true"></span>{% endif %}
      {% for g in gallery %}<img src="{{ g }}" alt="{{ title }} detail" loading="lazy">{% endfor %}
    </div>
    <div class="pdp__info">
      <p class="eyebrow">{{ brand }}{% if range %} &middot; {{ range }}{% endif %}</p>
      <h1>{{ title }}</h1>
      <div class="prose">{{ content | safe }}</div>
      {% if specs %}
      <dl class="specs">
        {% for key, val in specs %}<div><dt>{{ key }}</dt><dd>{{ val }}</dd></div>{% endfor %}
      </dl>
      {% endif %}
      <div class="pdp__cta">
        <a class="btn" href="/quote/?product={{ (brand + ' ' + title) | urlencode }}">Request a free quote</a>
        <p class="note">Pricing on request. We bring samples to you and measure up for free.</p>
      </div>
    </div>
  </div>
</section>
